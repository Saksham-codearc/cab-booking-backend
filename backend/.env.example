# Server
PORT=5000

# Comma-separated list of browser origins allowed by CORS.
CORS_ORIGIN=http://localhost:3000

# Clerk (https://dashboard.clerk.com) — use your development instance keys.
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Supabase — the service-role key bypasses RLS. Never expose it to the client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Optional: enables Google Distance Matrix fare estimates.
# Without it, estimates fall back to a deterministic heuristic (source reported as "heuristic").
GOOGLE_MAPS_SERVER_KEY=replace_me
