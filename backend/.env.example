# Copy this file to `.env` and fill in real values. Never commit `.env`.

NODE_ENV=development
PORT=5000

# --- Clerk (required) -------------------------------------------------------
# The app refuses to start without these two.
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Supabase (required) ----------------------------------------------------
# The service-role key is server-only. Never send it to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- Optional integrations --------------------------------------------------
# Without GOOGLE_MAPS_SERVER_KEY, distance/fare falls back to a heuristic.
GOOGLE_MAPS_SERVER_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PLATFORM_FEE_PERCENT=20
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RECEIPT_FROM_EMAIL=

# --- Migrations only --------------------------------------------------------
# Used by `node scripts/apply-sql.mjs <file.sql>`. Not read by the server.
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
